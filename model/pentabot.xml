<mujoco model="pentabot">
  <!-- Generado desde Inventor (CuerpoBase.iam) por build.py/assemble.py. Unidades SI. Z arriba.
       Pierna de referencia (q=0): L1 en pose CAD de apoyo (fémur horizontal).
       Orden de piernas (antihorario visto desde arriba, L1 en ~37° desde +x):
       L1=Hombro:2@36.82°, L2=Hombro:1@109.31°, L3=Hombro:5@179.96°, L4=Hombro:4@250.59°, L5=Hombro:3@323.09°
       Convención de signos: hip_yaw + = antihorario (vista superior); hip_pitch + = sube el fémur; knee + = sube la tibia.
       Inerciales calculados (no desde geoms): PLA impreso = cáscara 0.8 mm + relleno 17.5 %,
       MG995 55 g, 6901 11 g, tornillería de acero. Electrónica = PLACEHOLDER 0.18 kg. -->
  <compiler angle="radian" meshdir="assets" inertiafromgeom="false" autolimits="true"/>

  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <default class="pentabot">
      <default class="mg995">
        <!-- motor: damping = tau_stall/omega_0 reproduce la curva par-velocidad;
             armature = inercia reflejada del rotor (estimada, calibrar); frictionloss = rozamiento de engranajes -->
        <joint type="hinge" range="-1.5708 1.5708" damping="0.1499" armature="0.005" frictionloss="0.03"/>
        <position kp="11.241" forcerange="-0.981 0.981" ctrlrange="-1.5708 1.5708"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" mass="0" density="0"/>
      </default>
      <default class="collision">
        <!-- solo chocan con el suelo (sin auto-colisión) -->
        <geom type="mesh" contype="0" conaffinity="1" group="3" mass="0" density="0" friction="0.5 0.005 0.0001"/>
      </default>
      <default class="foot">
        <!-- esfera Ø36 mm con casquete TPU: fricción TPU-suelo ~0.9; condim 6 añade torsión/rodadura -->
        <geom type="sphere" size="0.018" contype="0" conaffinity="1" group="3" mass="0" density="0"
              condim="6" priority="1" friction="0.9 0.005 0.0001" solref="0.005 1" solimp="0.9 0.95 0.001"
              rgba="1 0.235 0 1"/>
      </default>
      <site group="4" rgba="0 1 0 0.5"/>
    </default>
  </default>

